# Do not overwrite image .venv from `uv sync` (host symlinks break in-container Python).
.venv/
.uv/
venv/
ENV/

.git/
.gitignore

# Frontend and local data are not needed for the API image
frontend/
data/

# Traefik / Pocket ID stack config is not copied into the API image.
# Also avoids build failures when bind mounts leave root-owned sed* temp files unreadable on the host.
docker/

.env
.env.*
!.env.example

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
