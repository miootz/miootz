# ENV FILE FOR THE LOCAL DEV STACK (docker-compose.dev.yml).
# Compose interpolates the ${...} values below — and every Traefik Host() rule — from
# THIS file, so invoke the dev stack with:
#
#   cp .env.dev.example .env.dev
#   ./scripts/bootstrap.sh --dev            # or:
#   docker compose --env-file .env.dev -f docker-compose.dev.yml up -d
#
# Add the three hosts to /etc/hosts (or local DNS) pointing at 127.0.0.1:
#   127.0.0.1 app.miootz.local api.miootz.local auth.miootz.local

# ── Hosts (interpolated into the Traefik routers) ───────────────────────
# Dev serves TLS on :8443 (mkcert certs in docker/traefik/certs), so the port shows up
# in every URL. Host() matching ignores the port; the URLs below must include it.
AUTH_DOMAIN=auth.miootz.local    # Pocket ID (OIDC issuer)
API_DOMAIN=api.miootz.local      # API (also served same-origin under app/<...>/api)
APP_DOMAIN=app.miootz.local      # React frontend

# ── Required (generated by bootstrap) ────────────────────────────────────
ENCRYPTION_KEY=change-me-to-a-random-hex-string-at-least-32-chars
POCKET_ID_STATIC_API_KEY=

# ── Public app URL ──────────────────────────────────────────────────────
# Base URL for push-notification deep-links (no trailing slash). Must match APP_DOMAIN.
PUBLIC_APP_URL=https://app.miootz.local:8443

# ── CORS / Host ─────────────────────────────────────────────────────────
CORS_ORIGINS=
TRUSTED_HOSTS=app.miootz.local,api.miootz.local,auth.miootz.local

# ── Pocket ID OIDC ──────────────────────────────────────────────────────
POCKET_ID_OIDC_CLIENT_ID=miootz-app
POCKET_ID_OIDC_ISSUER=https://auth.miootz.local:8443
POCKET_ID_APP_URL=https://auth.miootz.local:8443
POCKET_ID_MEMBERS_GROUP_ID=

# ── Web Push (VAPID) ───────────────────────────────────────────────────
# Leave both empty to disable push notifications. This is push, not mail: `mailto:` is
# the VAPID contact URI required by the spec.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@localhost

# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/miootz.db

# ── Scheduler / Uploads ────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
