# ENV FILE FOR THE PROD STACK (docker-compose.yml). Use `.env.dev.example` for the
# local dev stack (docker-compose.dev.yml). This file MUST exist before you run
# `docker compose up` — Compose interpolates every ${...} below (and every Traefik
# Host() rule) from THIS file only; service-level `env_file:` entries do not feed
# interpolation.
#
#   cp .env.example .env      # then fill in the values
#   docker compose up -d

# ── Hosts (interpolated into the Traefik routers) ───────────────────────
# Prod serves on the default TLS port, so no port appears in any URL.
# Register these three names in DNS (or point a wildcard at the host running Traefik).
AUTH_DOMAIN=auth.example.com   # Pocket ID (OIDC issuer)
API_DOMAIN=api.example.com     # API reached as api.<domain>/api ...
APP_DOMAIN=app.example.com     # React frontend

# ── Required ──────────────────────────────────────────────────────────
# Symmetric signing key for action tokens, magic links, etc.
SECRET_KEY=change-me-to-a-random-string

# Pocket ID encryption key (at least 16 bytes, used for passkey data encryption).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=change-me-to-a-random-hex-string-at-least-32-chars

# Pocket ID static API key — grants admin access for declarative bootstrap.
# Leave empty if you set up Pocket ID manually via the UI.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
POCKET_ID_STATIC_API_KEY=

# ── Database ──────────────────────────────────────────────────────────
# SQLite (default). Change for PostgreSQL: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./data/miootz.db

# ── Public app URL ───────────────────────────────────────────────────
# Base URL for push-notification deep-links (no trailing slash). Must match APP_DOMAIN.
PUBLIC_APP_URL=https://app.example.com

# ── CORS / Host ──────────────────────────────────────────────────────
# Comma-separated allowed origins (empty = no CORS middleware). The browser calls the
# API same-origin from APP_DOMAIN, so this can stay empty unless you split origins.
CORS_ORIGINS=
# Comma-separated trusted Host values (empty = disabled).
TRUSTED_HOSTS=app.example.com,api.example.com,auth.example.com

# ── Pocket ID OIDC ────────────────────────────────────────────────────
# Issuer URL — must match AUTH_DOMAIN above (prod has no port; the dev template uses :8443).
POCKET_ID_OIDC_ISSUER=
# OIDC client ID registered in Pocket ID
POCKET_ID_OIDC_CLIENT_ID=miootz-app
# ── Pocket ID admin API (signup tokens) ──────────────────────────────
# Internal URL for Pocket ID container (Docker: http://pocket-id:1411)
POCKET_ID_INTERNAL_URL=
# Public URL for Pocket ID (same as POCKET_ID_OIDC_ISSUER typically)
POCKET_ID_APP_URL=
# Admin API key — POCKET_ID_STATIC_API_KEY above is used automatically.
# Only set this if you want a separate JWT-based API key from Pocket ID UI.
POCKET_ID_API_KEY=
# Pocket ID group UUID for new signups ("members" group)
POCKET_ID_MEMBERS_GROUP_ID=

# ── Web Push (VAPID) ─────────────────────────────────────────────────
# Leave both empty to disable push notifications.
# Generate: python -c "from pyvapid import generate_vapid_keys; print(generate_vapid_keys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID contact URI per the Web Push spec (RFC 8297 / VAPID): a `mailto:` address or
# `https:` URL where the push service can reach the sender. This is NOT mail/SMTP
# configuration — the stack sends no email, pushes only.
VAPID_SUBJECT=mailto:noreply@example.com

# ── Scheduler ─────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC

# ── Uploads ───────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_AVATAR_BYTES=2097152
