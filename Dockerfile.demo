# Demo image: python -m app.demo (docs/DEMO.md) — API + Vite dev server in one
# container, no Pocket ID, fresh temporary SQLite database per run.
FROM node:22-bookworm-slim AS nodejs

FROM ghcr.io/astral-sh/uv:python3.14-trixie

# Node 22 (for the Vite dev server the demo spawns) from the node stage.
COPY --from=nodejs /usr/local/bin /usr/local/bin
COPY --from=nodejs /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=nodejs /usr/local/include/node /usr/local/include/node

WORKDIR /app

COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen

COPY app ./app
COPY scripts ./scripts
COPY frontend ./frontend
RUN cd frontend && npm ci --no-audit --no-fund

CMD ["uv", "run", "python", "-m", "app.demo", "--scenario", "full"]
